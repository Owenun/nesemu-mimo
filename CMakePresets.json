{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development (headless + tests)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "NESEMU_BUILD_DESKTOP": "OFF",
        "NESEMU_BUILD_TESTS": "ON",
        "NESEMU_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "desktop",
      "displayName": "Desktop Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "NESEMU_BUILD_DESKTOP": "ON",
        "NESEMU_BUILD_TESTS": "ON",
        "NESEMU_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "desktop-release",
      "displayName": "Desktop Release + package",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NESEMU_BUILD_DESKTOP": "ON",
        "NESEMU_BUILD_TESTS": "OFF",
        "NESEMU_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "desktop", "configurePreset": "desktop" },
    { "name": "desktop-release", "configurePreset": "desktop-release" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "output": { "outputOnFailure": true }
    }
  ]
}
